{
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-write --allow-env main.ts",
    "check": "deno check main.ts",
    "compile": "deno compile --allow-net --allow-read --allow-write --allow-env --output xp main.ts"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  }
}
